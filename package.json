{
  "name": "arcmint-tg-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram trading bot for Arc Mainnet (Cove-style UX)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop arctrade-bot",
    "pm2:logs": "pm2 logs arctrade-bot"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.36.3",
    "sharp": "^0.35.3",
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
