# Telegram
TELEGRAM_BOT_TOKEN=
# Optional: only these Telegram user IDs can use the bot (comma-separated). Empty = open.
TELEGRAM_ALLOWLIST=

# Arc MAINNET only (NOT testnet 5042002)
# From radardex.io CFG + Rabby-compatible public endpoints
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
ARC_RPC_FALLBACKS=https://5042.rpc.thirdweb.com
ARC_EXPLORER=https://arc-scan.org

# Tokens (RadarDEX / Arc Mainnet)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Uniswap V3 stack used by RadarDEX on Arc Mainnet
SWAP_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77
QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468
FEE_ROUTER=0x2804d131cfB046f987E7e532Bc58CFC30326B350

# Security: 32-byte hex for AES-GCM wallet encryption at rest
# openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# Defaults (Cove-style)
DEFAULT_SLIPPAGE_BPS=100
DEFAULT_BUY_PRESETS=5,10,25,50,100

# Platform fee (USDC) — lands on treasury; referral share paid to inviter wallet
FEE_TREASURY_ADDRESS=0x850cd1A1940C0653d78Dff6311D7a5166b8098a3
PLATFORM_FEE_BPS=100
REFERRAL_SHARE_BPS=2500
BOT_USERNAME=ArcTraderXbot
# Optional tokenlist API. Leave empty — the old Blockscout host is dead.
# ARC_BLOCKSCOUT_URL=
# Never show treasury to users. Comma-separated fee-free wallets (owner):
FEE_EXEMPT_WALLETS=0x850cd1A1940C0653d78Dff6311D7a5166b8098a3
